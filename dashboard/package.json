{
  "name": "jobful-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "import:workbook": "python3 ../scripts/import-ai-job-workbook.py && node ../scripts/build-recommendations-from-growth.js",
    "sync:data": "mkdir -p public && for f in upGrowthInvestmentReport.json upAiRecommendations.json; do if [ -f ../data/$f ]; then cp ../data/$f public/$f; elif [ ! -f public/$f ]; then echo \"Missing workbook data: public/$f (and ../data/$f not found)\"; exit 1; fi; done",
    "predev": "npm run sync:data",
    "prebuild": "npm run sync:data",
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-leaflet": "^4.2.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0"
  }
}
